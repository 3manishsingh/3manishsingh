\par \hich\af31506\dbch\af31505\loch\f31506 func cloneGraph(node *Node) *Node \{
\par \hich\af31506\dbch\af31505\loch\f31506     oldToNew := make(map[*Node]*Node)
\par 
\par \hich\af31506\dbch\af31505\loch\f31506     var dfs func(*Node) *Node
\par \hich\af31506\dbch\af31505\loch\f31506     dfs = func(node *Node) *Node \{
