\par \hich\af31506\dbch\af31505\loch\f31506         copy := &Node\{Val: node.Val\}
\par \hich\af31506\dbch\af31505\loch\f31506         oldToNew[node] = copy
\par \hich\af31506\dbch\af31505\loch\f31506         for _, nei := range node.Neighbors \{
\par \hich\af31506\dbch\af31505\loch\f31506             copy.Neighbors = append(copy.Neighbors, dfs(nei))
\par \hich\af31506\dbch\af31505\loch\f31506         \}
\par \hich\af31506\dbch\af31505\loch\f31506         return copy
\par \hich\af31506\dbch\af31505\loch\f31506     \}
