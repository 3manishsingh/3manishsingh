\f0\b\fs36 \cf0 \strokec2 13. Pivot Queries\
\pard\pardeftab720\sa240\partightenfactor0

\fs24 \cf0 Definition
\f1\b0 \
Transform rows into columns.\
Example: total spending per country.\
\pard\pardeftab720\partightenfactor0

\f2\fs26 \cf0 \
SELECT\
SUM(CASE WHEN country = 'USA' THEN 1 ELSE 0 END) AS USA_customers,\
SUM(CASE WHEN country = 'UK' THEN 1 ELSE 0 END) AS UK_customers,\
SUM(CASE WHEN country = 'UAE' THEN 1 ELSE 0 END) AS UAE_customers\
FROM Customers;\
\
\pard\pardeftab720\partightenfactor0

