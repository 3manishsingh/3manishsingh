\pard\pardeftab720\sa298\partightenfactor0

\f0\b\fs36 \cf0 \strokec2 14. Anti Join\
\pard\pardeftab720\sa240\partightenfactor0

\fs24 \cf0 Definition
\f1\b0 \
Finding rows 
\f0\b in one table but not in another
\f1\b0 .\
Example: customers who never placed orders.\
\pard\pardeftab720\partightenfactor0

\f2\fs26 \cf0 \
SELECT *\
FROM Customers c\
LEFT JOIN Orders o\
ON c.customer_id = o.customer_id\
WHERE o.customer_id IS NULL;\
\
\pard\pardeftab720\partightenfactor0

\f1\fs24 \cf3 \strokec3 \
\pard\pardeftab720\sa298\partightenfactor0

\f0\b\fs36 \cf0 \strokec2 15. Data Deduplication\
\pard\pardeftab720\sa240\partightenfactor0

\fs24 \cf0 Definition
\f1\b0 \
Removing duplicate rows.\
Example: keep only first duplicate.\
\pard\pardeftab720\partightenfactor0

\f2\fs26 \cf0 \
DELETE FROM Customers\
WHERE customer_id IN (\
SELECT customer_id\
FROM (\
SELECT\
customer_id,\
ROW_NUMBER() OVER (PARTITION BY first_name, last_name ORDER BY customer_id) AS rnk\
FROM Customers\
) t\
WHERE rnk > 1\
);\
\
\pard\pardeftab720\partightenfactor0

