\f0\b\fs36 \cf0 \strokec2 Final Interview Understanding Order\
\pard\pardeftab720\sa240\partightenfactor0

\f1\b0\fs24 \cf0 For SQL interviews remember this logical order:\
\pard\pardeftab720\partightenfactor0

\f2\fs26 \cf0 \
1 SELECT\
2 WHERE\
3 GROUP BY\
4 HAVING\
5 ORDER BY\
6 LIMIT\
\
\pard\pardeftab720\sa240\partightenfactor0

\f1\fs24 \cf0 JOINs and subqueries work 
\f0\b inside this pipeline
\f1\b0 .\
\pard\pardeftab720\partightenfactor0
\cf3 \strokec3 \
\pard\pardeftab720\sa240\partightenfactor0
